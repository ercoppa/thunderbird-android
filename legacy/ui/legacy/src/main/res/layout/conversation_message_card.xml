<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    >

    <LinearLayout
        android:id="@+id/conversation_card_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        >

        <View
            android:id="@+id/conversation_card_unread_indicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/conversation_unread_dot"
            tools:visibility="visible"
            />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            >

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/conversation_card_draft_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/message_list_item_draft"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textColor="?attr/colorError"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:visibility="gone"
                tools:visibility="visible"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/conversation_card_sender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                tools:text="Alice Example"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/conversation_card_snippet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?android:attr/textColorSecondary"
                tools:text="Re: Aaa — message preview text goes here"
                />

        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/conversation_card_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="6/8"
            />

        <ImageView
            android:id="@+id/conversation_card_edit_draft"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/edit_draft_action"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            tools:src="@drawable/ic_edit"
            tools:visibility="visible"
            />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/conversation_card_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:visibility="visible"
        />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider"
        />

</LinearLayout>
